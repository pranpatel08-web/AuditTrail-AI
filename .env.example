# ---------------------------------------------------------------------------
# AuditTrail AI — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Clocked (required). Get a key at https://clocked.rezolve.ai -> Settings -> API Access.
CLOCKED_API_KEY=clk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOCKED_API_URL=https://clocked.rezolve.ai/clocked

# Supabase (optional, but required for accounts and multi-tenant persistence).
# Run supabase/schema.sql in the SQL editor first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Storage: auto (default) probes Supabase and falls back to SQLite.
STORAGE_BACKEND=auto
DATABASE_PATH=./data/audittrail.db

# Product behaviour
ALLOW_DEMO_MODE=true
FAIL_CLOSED=true
MAX_LEASE_CHARS=60000
MAX_RULES_CHARS=120000

# Billing (optional). Without these the product runs in a labelled sandbox.
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_PRICE_PRO=price_xxx
# STRIPE_PRICE_FIRM=price_xxx
